# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Master key used to encrypt per-user IMAP credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Path to the SQLite database file (relative paths are resolved from the working directory).
DATABASE_PATH=data/bot.sqlite3

# Optional: comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone (not recommended for public deployments).
ALLOWED_USER_IDS=

# Logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# How often (in minutes) to re-scan the inbox for new aliases (auto-sync).
ALIAS_SYNC_INTERVAL_MINUTES=5

# Base URL for the captcha-helper page (serves the Proton CAPTCHA in an iframe
# and exposes the hCaptcha response token for the user to copy-paste back to the bot).
# Leave empty to fall back to the raw verify.proton.me URL (token won't be exposed).
# Example: http://YOUR_VPS_IP:8090/captcha/index.html
CAPTCHA_HELPER_BASE_URL=
